{
  "name": "mtg-recommender-server",
  "private": true,
  "version": "0.1.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "tsx scripts/test-parse-list.ts && tsx scripts/test-spellbook.ts",
    "start": "node dist/index.js",
    "fetch-scryfall": "tsx scripts/fetch-scryfall.ts",
    "import-scryfall": "tsx scripts/import-scryfall.ts",
    "prepare-data": "npm run fetch-scryfall && npm run import-scryfall",
    "prepare-data:fresh": "tsx scripts/fetch-scryfall.ts --force && npm run import-scryfall"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
